{
  "name": "@billnote/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:push": "prisma db push --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@billnote/config": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
