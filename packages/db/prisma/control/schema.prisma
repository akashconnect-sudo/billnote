generator client {
  provider = "prisma-client"
  output   = "../../generated/control"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName         String    @map("full_name")
  email            String?   @unique @db.Citext
  phoneE164        String?   @unique @map("phone_e164")
  passwordHash     String?   @map("password_hash")
  locale           String    @default("en")
  status           String    @default("active")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt  DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  totpSecretEnc    String?   @map("totp_secret_enc")
  totpEnabledAt    DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessions         Session[]
  memberships      Membership[]
  ownedBusinesses  Business[]      @relation("BusinessOwner")
  otpChallenges    OtpChallenge[]
  loginEvents      LoginEvent[]
  consentRecords   ConsentRecord[]
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

model OtpChallenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  destination String
  channel     String
  purpose     String
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([destination, createdAt(sort: Desc)], map: "otp_challenges_destination_idx")
  @@map("otp_challenges")
}

model Session {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @map("refresh_token_hash")
  familyId             String    @map("family_id") @db.Uuid
  replacedBySessionId  String?   @map("replaced_by_session_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason         String?   @map("revoke_reason")
  userAgent            String?   @map("user_agent")
  ip                   String?   @db.Inet
  deviceLabel          String?   @map("device_label")
  platform             String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)], map: "sessions_user_idx")
  @@index([familyId], map: "sessions_family_idx")
  @@map("sessions")
}

model LoginEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  success    Boolean
  reason     String?
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)], map: "login_events_user_idx")
  @@map("login_events")
}

model Business {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId   String    @map("owner_user_id") @db.Uuid
  legalName     String    @map("legal_name")
  displayName   String    @map("display_name")
  categoryKey   String    @map("category_key")
  status        String    @default("provisioning")
  clusterKey    String    @default("primary") @map("cluster_key")
  databaseName  String    @unique @map("database_name")
  schemaVersion Int       @default(0) @map("schema_version")
  region        String    @default("ap-south-1")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner           User                 @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  memberships     Membership[]
  staffInvites    StaffInvite[]
  migrationState  TenantMigrationState?
  migrationRuns   TenantMigrationRun[]
  subscriptions   Subscription[]
  subscriptionInvoices SubscriptionInvoice[]

  @@index([ownerUserId], map: "businesses_owner_idx")
  @@map("businesses")
}

model Membership {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  status      String   @default("active")
  permVersion Int      @default(1) @map("perm_version")
  isDefault   Boolean  @default(false) @map("is_default")
  roleKey     String   @default("owner") @map("role_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
  @@index([userId], map: "memberships_user_idx")
  @@map("memberships")
}

model StaffInvite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  destination String
  roleKey     String    @map("role_key")
  tokenHash   String    @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("staff_invites")
}

model TenantMigrationState {
  businessId     String    @id @map("business_id") @db.Uuid
  currentVersion Int       @default(0) @map("current_version")
  targetVersion  Int       @default(0) @map("target_version")
  status         String    @default("idle")
  lockedBy       String?   @map("locked_by")
  lockExpiresAt  DateTime? @map("lock_expires_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("tenant_migration_state")
}

model TenantMigrationRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  version    Int
  checksum   String
  status     String
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  error      String?

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, version, startedAt])
  @@map("tenant_migration_runs")
}

model Plan {
  id                 String  @id
  name               String
  priceMonthlyPaise  BigInt  @map("price_monthly_paise")
  priceYearlyPaise   BigInt  @map("price_yearly_paise")
  limits             Json
  features           Json
  active             Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String    @map("business_id") @db.Uuid
  planId                 String    @map("plan_id")
  status                 String
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart     DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime  @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  razorpaySubscriptionId String?   @map("razorpay_subscription_id")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business              @relation(fields: [businessId], references: [id])
  plan     Plan                  @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  subscriptionId    String   @map("subscription_id") @db.Uuid
  amountPaise       BigInt   @map("amount_paise")
  gstPaise          BigInt   @default(0) @map("gst_paise")
  status            String
  razorpayInvoiceId String?  @map("razorpay_invoice_id")
  pdfObjectKey      String?  @map("pdf_object_key")
  issuedOn          DateTime @map("issued_on") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business     Business     @relation(fields: [businessId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_invoices")
}

model ProcessedGatewayEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider   String
  eventId    String   @map("event_id")
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("processed_gateway_events")
}

model AppRelease {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform      String
  version       String
  buildNumber   Int      @map("build_number")
  minSupported  Boolean  @default(false) @map("min_supported")
  channel       String   @default("prod")
  releaseNotes  String   @default("") @map("release_notes")
  releasedAt    DateTime @default(now()) @map("released_at") @db.Timestamptz(6)

  @@unique([platform, version, buildNumber, channel])
  @@map("app_releases")
}

model ConsentRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  purpose       String
  granted       Boolean
  policyVersion String   @map("policy_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)], map: "consent_records_user_idx")
  @@map("consent_records")
}

model BarcodeLookupCache {
  barcode    String   @id
  payload    Json
  source     String
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("barcode_lookup_cache")
}

model IdempotencyKey {
  key         String   @id
  userId      String?  @map("user_id") @db.Uuid
  method      String
  path        String
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@map("idempotency_keys")
}
