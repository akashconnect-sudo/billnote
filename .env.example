NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
EXPOSE_DOCS=true
LOG_LEVEL=info

# DynamoDB
AWS_REGION=ap-south-1
DDB_TABLE=billnote
# Local DynamoDB (docker compose service):
DDB_ENDPOINT=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Production web (DuckDNS)
# NEXT_PUBLIC_API_URL=https://notebill.duckdns.org
# WEB_ORIGIN=https://notebill.duckdns.org
# DUCKDNS_TOKEN=
# DUCKDNS_DOMAIN=notebill
