NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
EXPOSE_DOCS=true
LOG_LEVEL=info

# DynamoDB
AWS_REGION=ap-south-1
DDB_TABLE=billnote
# Local DynamoDB (docker compose service):
DDB_ENDPOINT=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Production web (DuckDNS)
# NEXT_PUBLIC_API_URL=https://notebill.duckdns.org
# WEB_ORIGIN=https://notebill.duckdns.org
# DUCKDNS_TOKEN=
# DUCKDNS_DOMAIN=notebill

# Email OTP (login + signup)
# EMAIL_PROVIDER=console   # local: logs OTP to API console
# EMAIL_PROVIDER=ses       # AWS SES (verified identity required)
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=BILLNOTE <noreply@notebill.duckdns.org>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_EXPOSE_OTP=true    # only for debugging — never in real prod
