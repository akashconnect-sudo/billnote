{
  "name": "billnote",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:ensure-table": "pnpm --filter @billnote/db ddb:ensure-table",
    "smoke:ddb": "tsx scripts/smoke-ddb.ts",
    "help:missing": "pnpm --filter @billnote/shared exec vitest run src/help/missing-ids.test.ts"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "dynalite": "^4.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
