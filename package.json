{
  "name": "billnote",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @billnote/db prisma:generate",
    "db:migrate": "pnpm --filter @billnote/db prisma:migrate:dev",
    "db:push": "pnpm --filter @billnote/db db:push",
    "help:missing": "pnpm --filter @billnote/shared exec vitest run src/help/missing-ids.test.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
